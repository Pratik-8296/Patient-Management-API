{
  "name": "patient-management-api",
  "version": "1.0.0",
  "description": "Production-grade Serverless Patient Management API",
  "main": "dist/lambda.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "dev": "dotenv -e .env -- npx ts-node src/lambda.ts",
    "offline": "serverless offline --stage local",
    "start": "npm run build && node dist/lambda.js",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "deploy": "serverless deploy --stage prod",
    "deploy:dev": "serverless deploy --stage dev",
    "remove": "serverless remove",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.540.0",
    "@aws-sdk/lib-dynamodb": "^3.540.0",
    "@opensearch-project/opensearch": "^2.5.0",
    "aws-jwt-verify": "^4.0.0",
    "express": "^4.19.2",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "serverless-http": "^3.2.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "@types/yamljs": "^0.2.34",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^11.0.0",
    "serverless": "^3.38.0",
    "serverless-offline": "^12.0.4",
    "serverless-plugin-typescript": "^2.1.5",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "patient-management",
    "serverless",
    "aws-lambda",
    "dynamodb",
    "opensearch",
    "cognito",
    "typescript"
  ],
  "license": "MIT"
}
