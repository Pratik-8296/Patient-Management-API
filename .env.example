# ========================
# Application
# ========================
NODE_ENV=development
PORT=3001
API_VERSION=v1
LOG_LEVEL=debug

# ========================
# AWS General
# ========================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ========================
# DynamoDB
# ========================
DYNAMODB_TABLE_NAME=patients
# Leave empty to use AWS (set for local development)
DYNAMODB_ENDPOINT=

# ========================
# OpenSearch
# ========================
OPENSEARCH_ENDPOINT=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Leave empty for SigV4 signing with IAM role
OPENSEARCH_USE_BASIC_AUTH=false
# Comma-separated list of nodes for local dev
OPENSEARCH_LOCAL_NODE=http://localhost:9200

# ========================
# Cognito
# After `npm run deploy`, copy these values from the CloudFormation Outputs
# tab in the AWS Console (or from the serverless deploy output)
# ========================
COGNITO_USER_POOL_ID=        # CloudFormation Output: CognitoUserPoolId
COGNITO_CLIENT_ID=           # CloudFormation Output: CognitoUserPoolClientId
COGNITO_REGION=us-east-1     # Must match your --region deploy flag

# ========================
# Serverless Offline (local dev)
# ========================
IS_OFFLINE=false
